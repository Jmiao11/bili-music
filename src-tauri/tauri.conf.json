{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bili Music",
  "version": "1.0.0",
  "identifier": "com.bili.music",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "visible": false,
        "title": "Bili Music",
        "width": 1180,
        "height": 760,
        "minWidth": 1080,
        "minHeight": 600,
        "decorations": false,
        "dragDropEnabled": false,
        "resizable": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "resources": [],
    "externalBin": []
  }
}
